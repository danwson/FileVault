APP_NAME=FileVault
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Container "mysql" do docker-compose.yml
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=filevault
DB_USERNAME=filevault
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Container "redis" do docker-compose.yml
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Credenciais S3-compatible apontando para o container "minio". O disco "s3"
# só passa a ser usado pela aplicação quando o upload de arquivos for
# implementado (etapa 3) — por enquanto FILESYSTEM_DISK continua "local".
AWS_ACCESS_KEY_ID=filevault
AWS_SECRET_ACCESS_KEY=secretkey123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=filevault
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/filevault

# Usadas pelo serviço "minio" e pelo job "minio-init" no docker-compose.yml
# (devem bater com AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_BUCKET acima)
MINIO_ROOT_USER=filevault
MINIO_ROOT_PASSWORD=secretkey123
MINIO_BUCKET=filevault

# Portas expostas no host pelo docker-compose.yml (todas vinculadas a
# 127.0.0.1, veja o topo do docker-compose.yml). FORWARD_REDIS_PORT usa
# 6380 em vez do padrão 6379 porque é comum já haver um Redis local (ex.:
# DBngin) ocupando essa porta — ajuste se colidir com outro serviço seu.
APP_PORT=8000
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6380
FORWARD_MINIO_PORT=9000
FORWARD_MINIO_CONSOLE_PORT=9001

VITE_APP_NAME="${APP_NAME}"
